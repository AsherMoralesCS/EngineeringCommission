ines 234–255"><mxGeometry x="252.363037109375" y="368.0" width="233.27392578125" height="78" as="geometry" /></mxCell><mxCell id="no_intersection" value="discriminant &lt;&#10;-policy.squared_length?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="228.052734375" y="475.0" width="281.89453125" height="76" as="geometry" /></mxCell><mxCell id="error" value="raise TraverseError(&quot;No solution: the known&#10;length cannot reach the known-bearing ray.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="36.11505859375001" y="590.0" width="325.7698828125" height="56.00000000000001" as="geometry" /></mxCell><mxCell id="near_zero" value="abs(discriminant) &lt;=&#10;policy.roundoff_squared?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="391.43115234375" y="580.0" width="297.1376953125" height="76" as="geometry" /></mxCell><mxCell id="clamp" value="discriminant = 0.0" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="401.5" y="685.0" width="155" height="42" as="geometry" /></mxCell><mxCell id="root" value="root = math.sqrt(max(0, discriminant))&#10;candidates = []" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="420.210205078125" y="756.0" width="239.57958984375" height="50" as="geometry" /></mxCell><mxCell id="loop" value="More length values in&#10;(projection + root, projection -&#10;root)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="362.3896484375" y="835.0" width="355.220703125" height="104" as="geometry" /></mxCell><mxCell id="positive" value="length &lt;= policy.length?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="258.73095703125" y="968.0" width="294.5380859375" height="48" as="geometry" /></mxCell><mxCell id="candidate" value="candidate = list(sides)&#10;candidate[i] = replace(sides[i],&#10;length=length)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_ii: traverse_solver.py lines 234–255"><mxGeometry x="363.484130859375" y="1045.0" width="195.03173828125" height="64" as="geometry" /></mxCell><mxCell id="bearing" value="candidate[j] = replace(sides[j],&#10;    azimuth=vector_azimuth(east - length * ue,&#10;                           north - length *&#10;un))" style="shape=process;html=0;white