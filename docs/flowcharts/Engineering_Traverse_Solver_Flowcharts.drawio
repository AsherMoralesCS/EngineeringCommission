.0" width="155" height="42" as="geometry" /></mxCell><mxCell id="basis" value="height = math.sqrt(max(0, height_sq))&#10;ue, un = target[0] / distance, target[1] /&#10;distance&#10;candidates = []" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="1224.083740234375" y="862.0" width="244.83251953125" height="78" as="geometry" /></mxCell><mxCell id="loop" value="More sign values in (1, -1)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="1187.076171875" y="969.0" width="318.84765625" height="48" as="geometry" /></mxCell><mxCell id="first_vector" value="east = along * ue - sign * height * un&#10;north = along * un + sign * height * ue&#10;candidate = list(sides)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="986.812255859375" y="1046.0" width="239.37548828125" height="64" as="geometry" /></mxCell><mxCell id="bearings" value="candidate[i] = replace(sides[i],&#10;    azimuth=vector_azimuth(east, north))&#10;candidate[j] = replace(sides[j],&#10;    azimuth=vector_azimuth(target[0] - east,&#10;target[1] - north))" style="shape=process;html=0;whiteSpace=wrap;rounded=0;fillColor=#edf2fa;strokeColor=#33548b;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="vector_azimuth: traverse_solver.py l