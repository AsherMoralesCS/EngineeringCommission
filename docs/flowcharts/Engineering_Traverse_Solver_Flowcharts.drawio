aphModel></diagram><diagram id="p08a" name="08a Evaluate one candidate"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="794" pageHeight="1207"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="meta_title" value="08a  Evaluate one candidate" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36" y="6" width="722.0" height="30" as="geometry" /></mxCell><mxCell id="meta_subtitle" value="evaluate_solution() derives components and coordinates, rejects non-finite coordinates, calculates polygon area, and&#10;returns a Solution. It does not decide candidate acceptance." style="text;html=0;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="36" y="40" width="722.0" height="50" as="geometry" /></mxCell><mxCell id="start" value="evaluate_solution(sides, initial_e, initial_n)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="190.8679833984375" y="99.97999999999999" width="303.264033203125" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="components" value="components = [vector(side) for side in sides]&#10;vector(side): east, north =&#10;unit_vector(side.azimuth)&#10;return side.length * east, side.length * north" style="shape=process;html=0;whiteSpace=wrap;rounded=0;fillColor=#edf2fa;strokeColor=#33548b;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="vector: traverse_solver.py lines 178–180"><mxGeometry x="206.145751953125" y="176.0" width="272.70849609375" height="78" as="geometry" /></mxCell><mxCell id="policy" value="perimeter = math.fsum(side.length for side in&#10;sides)&#10;policy = NumericalPolicy(perimeter)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="203.64013671875" y="283.0" width="277.7197265625" height="64" as="geometry" /></mxCell><mxCell id="local" value="local = [(0.0, 0.0)] + [&#10;    (math.fsum(e for e, _ in components[:i]),&#10;     math.fsum(n for _, n in components[:i]))&#10;    for i in range(1, len(sides) + 1)]" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="211.11669921875" y="376.0" width="262.7666015625" height="78" as="geometry" /></mxCell><mxCell id="coordinates" value="coordinates = [(initial_e + e, initial_n + n)&#10;for e, n in local]" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="214.465576171875" y="483.0" width="256.06884765625" height="50" as="geometry" /></mxCell><mxCell id="finite" value="any(not math.isfinite(value)&#10;    for point in coordinates for&#10;value in point)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="171.603515625" y="562.0" width="341.79296875" height="104" as="geometry" /></mxCell><mxCell id="error" value="raise TraverseError(&quot;Coordinates exceed the&#10;supported floating-point range.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="36.01850585937501" y="695.0" width="318.96298828125" height="56.00000000000001" as="geometry" /></mxCell><mxCell id="area" value="area = polygon_area(local, policy)&#10;See page 08b." style="shape=process;html=0;whiteSpace=wrap;rounded=0;fillColor=#edf2fa;strokeColor=#33548b;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="384.09765625" y="698.0" width="212.8046875" height="50" as="geometry" /></mxCell><mxCell id="valid_area" value="area is not None?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="383.90087890625" y="780.0" width="213.1982421875" height="48" as="geometry" /></mxCell><mxCell id="no_warning" value="warnings = []" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="289.0" y="868.0" width="155" height="42" as="geometry" /></mxCell><mxCell id="warning" value="warnings = [&quot;Crossed or degenerate boundary:&#10;sides intersect, touch, or retrace; area&#10;unavailable.&quot;]" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="472.939453125" y="857.0" width="285.12109375" height="64" as="geometry" /></mxCell><mxCell id="sum" value="sum_e, sum_n = local[-1]" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="408.52001953125" y="950.0" width="163.9599609375" height="42" as="geometry" /></mxCell><mxCell id="return" value="return Solution(sides, components, local,&#10;coordinates,&#10;    perimeter, sum_e, sum_n, math.hypot(sum_e,&#10;sum_n),&#10;    area, warnings, policy.length)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="evaluate_solution: traverse_solver.py lines 306–321"><mxGeometry x="318.11772949218755" y="1020.98" width="344.76454101562496" height="103.04" as="geometry" /></mxCell><mxCell id="e0" value="" parent="1" edge="1" source="start" target="components" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342.5" y="168.89999999999998" /></Array></mxGeometry></mxCell><mxCell id="e1" value="" parent="1" edge="1" source="components" target="policy" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342.5" y="275.97" /></Array></mxGeometry></mxCell><mxCell id="e2" value="" parent="1" edge="1" source="policy" target="local" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342.5" y="368.87" /></Array></mxGeometry></mxCell><mxCell id="e3" value="" parent="1" edge="1" source="local" target="coordinates" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342.5" y="475.91999999999996" /></Array></mxGeometry></mxCell><mxCell id="e4" value="" parent="1" edge="1" source="coordinates" target="finite" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="342.5" y="554.95" /></Array></mxGeometry></mxCell><mxCell id="e5" value="" parent="1" edge="1" source="finite" target="error" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="263.25" y="690.63" /></Array></mxGeometry></mxCell><mxCell id="edge_label5" value="Yes" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="244.88818359375" y="664.35" width="21.7236328125" height="14" as="geometry" /></mxCell><mxCell id="e6" value="" parent="1" edge="1" source="finite" target="area" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="448.75" y="690.64" /></Array></mxGeometry></mxCell><mxCell id="edge_label6" value="No" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="433.130615234375" y="660.19" width="18.23876953125" height="14" as="geometry" /></mxCell><mxCell id="e7" value="" parent="1" edge="1" source="area" target="valid_area" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490.5" y="772.94" /></Array></mxGeometry></mxCell><mxCell id="e8" value="" parent="1" edge="1" source="valid_area" target="no_warning" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="414.0" y="860.88" /></Array></mxGeometry></mxCell><mxCell id="edge_label8" value="Yes" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="395.63818359375" y="833.9200000000001" width="21.7236328125" height="14" as="geometry" /></mxCell><mxCell id="e9" value="" parent="1" edge="1" source="valid_area" target="warning" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535.0" y="849.9300000000001" /></Array></mxGeometry></mxCell><mxCell id="edge_label9" value="No" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="519.380615234375" y="831.98" width="18.23876953125" height="14" as="geometry" /></mxCell><mxCell id="e10" value="" parent="1" edge="1" source="no_warning" target="sum" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="426.25" y="942.95" /></Array></mxGeometry></mxCell><mxCell id="e11" value="" parent="1" edge="1" source="warning" target="sum" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="522.75" y="942.65" /></Array></mxGeometry></mxCell><mxCell id="e12" value="" parent="1" edge="1" source="sum" target="return" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490.5" y="1013.9300000000001" /></Array></mxGeometry></mxCell><mxCell id="meta_footer" value="traverse_solver.py · 0cf64fb · 17/27" style="text;html=0;align=left;fontSize=9;" vertex="1" parent="1"><mxGeometry x="36" y="1172.0" width="722.0" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p08b" name="08b Polygon boundary checks and shoelace area"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="831" pageHeight="1513"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="meta_title" value="08b  Polygon boundary checks and shoelace area" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36" y="6" width="758.5" height="30" as="geometry" /></mxCell><mxCell id="meta_subtitle" value="polygon_area(points, policy): return None for adjacent retracing, non-neighbor intersections or touching, or area at/below&#10;cross_tol. Called with local coordinates by evaluate_solution()." style="text;html=0;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="36" y="40" width="758.5" height="50" as="geometry" /></mxCell><mxCell id="start" value="polygon_area(points, policy)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="318.313828125" y="99.97999999999999" width="212.37234375" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="setup" value="vertices = points[:-1]&#10;count = len(vertices)&#10;tol, cross_tol = policy.length,&#10;policy.squared_length" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="332.44921875" y="176.0" width="184.1015625" height="78" as="geometry" /></mxCell><mxCell id="outer" value="More (i, a) in enumerate(vertices)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="222.42431640625" y="283.0" width="404.1513671875" height="48" as="geometry" /></mxCell><mxCell id="edge" value="b = vertices[(i + 1) % count]&#10;previous = vertices[i - 1]&#10;retraces = sum((p - q) * (r - q)&#10;    for p, q, r in zip(previous, a, b)) &gt;&#10;tol**2" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="128.25830078125" y="360.0" width="222.4833984375" height="92" as="geometry" /></mxCell><mxCell id="retraces" value="abs(cross(previous, a, b)) &lt;=&#10;cross_tol&#10;and retraces?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="36.20703125" y="481.0" width="344.5859375" height="104" as="geometry" /></mxCell><mxCell id="inner" value="More j in range(i + 1, count)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="224.71728515625" y="614.0" width="343.5654296875" height="48" as="geometry" /></mxCell><mxCell id="neighbors" value="j == i + 1&#10;or (i == 0 and j == count - 1)?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="216.68212890625" y="691.0" width="359.6357421875" height="76" as="geometry" /></mxCell><mxCell id="other_edge" value="c, d = vertices[j], vertices[(j + 1) % count]" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="280.396728515625" y="796.0" width="258.20654296875" height="42" as="geometry" /></mxCell><mxCell id="crosses" value="crosses = opposite(cross(a, b, c), cross(a, b,&#10;d))&#10;crosses &amp;= opposite(cross(c, d, a), cross(c,&#10;d, b))" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="289.29150390625" y="867.0" width="268.4169921875" height="78" as="geometry" /></mxCell><mxCell id="intersects" value="crosses or any((on_segment(a, b,&#10;c),&#10;    on_segment(a, b, d),&#10;on_segment(c, d, a),&#10;    on_segment(c, d, b)))?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="236.23388671875" y="974.0" width="388.5322265625" height="160" as="geometry" /></mxCell><mxCell id="area" value="area = abs(math.fsum(a[0] * b[1] - b[0] * a[1]&#10;    for a, b in zip(vertices,&#10;                    vertices[1:] +&#10;vertices[:1]))) / 2" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="495.3662109375" y="367.0" width="278.267578125" height="78" as="geometry" /></mxCell><mxCell id="area_threshold" value="area &gt; cross_tol?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="584.31884765625" y="509.0" width="210.3623046875" height="48" as="geometry" /></mxCell><mxCell id="return_area" value="return area" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="598.05" y="614.48" width="182.89999999999998" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="return_none" value="return None" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area: traverse_solver.py lines 188–221"><mxGeometry x="339.05" y="1162.98" width="182.89999999999998" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="cross_note" value="cross(a, b, c):&#10;return (b[0] - a[0]) * (c[1] - a[1])&#10;       - (b[1] - a[1]) * (c[0] - a[0])" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area.cross: traverse_solver.py lines 194–195"><mxGeometry x="36" y="1245.0" width="758.5" height="59" as="geometry" /></mxCell><mxCell id="opposite_note" value="opposite(a, b):&#10;return (a &gt; cross_tol and b &lt; -cross_tol)&#10;    or (a &lt; -cross_tol and b &gt; cross_tol)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area.opposite: traverse_solver.py lines 202–203"><mxGeometry x="36" y="1314.0" width="758.5" height="59" as="geometry" /></mxCell><mxCell id="segment_note" value="on_segment(a, b, p):&#10;return (abs(cross(a, b, p)) &lt;= cross_tol&#10;    and min(a[0], b[0]) - tol &lt;= p[0] &lt;= max(a[0], b[0]) + tol&#10;    and min(a[1], b[1]) - tol &lt;= p[1] &lt;= max(a[1], b[1]) + tol)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="polygon_area.on_segment: traverse_solver.py lines 197–200"><mxGeometry x="36" y="1383.0" width="758.5" height="72" as="geometry" /></mxCell><mxCell id="e0" value="" parent="1" edge="1" source="start" target="setup" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.5" y="168.9000000000001" /></Array></mxGeometry></mxCell><mxCell id="e1" value="" parent="1" edge="1" source="setup" target="outer" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424.5" y="275.87" /></Array></mxGeometry></mxCell><mxCell id="e2" value="" parent="1" edge="1" source="outer" target="edge" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;str