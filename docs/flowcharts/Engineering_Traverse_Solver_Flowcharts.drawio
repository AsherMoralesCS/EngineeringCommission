cing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="587.3512548828126" y="99.97999999999999" width="254.29749023437498" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="values" value="i, j = [i for i, s in enumerate(sides) if&#10;s.azimuth is None]&#10;a, b, distance = sides[i].length,&#10;sides[j].length, math.hypot(*target)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="602.8017578125" y="176.0" width="223.396484375" height="78" as="geometry" /></mxCell><mxCell id="zero" value="distance &lt;= policy.length?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="555.68310546875" y="283.0" width="317.6337890625" height="48" as="geometry" /></mxCell><mxCell id="equal" value="abs(a - b) &lt;= policy.length?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="357.57080078125" y="388.0" width="329.8583984375" height="48" as="geometry" /></mxCell><mxCell id="infinite" value="raise TraverseError(&quot;Infinitely many&#10;solutions: equal opposite sides can rotate&#10;freely; supply another bearing or engineering&#10;constraint.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="36.2330029296875" y="492.82" width="324.533994140625" height="87.36000000000001" as="geometry" /></mxCell><mxCell id="unequal" value="raise TraverseError(&quot;No solution: unequal&#10;lengths cannot sum to a zero vector.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="389.30490234375" y="508.5" width="298.3901953125" height="56.00000000000001" as="geometry" /></mxCell><mxCell id="triangle" value="distance &gt; a + b + policy.length&#10;or distance &lt; abs(a - b) -&#10;policy.length?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="716.59521484375" y="360.0" width="379.8095703125" height="104" as="geometry" /></mxCell><mxCell id="triangle_error" value="raise TraverseError(&quot;No solution: known&#10;lengths violate the triangle inequality.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iv: traverse_solver.py lines 278–303"><mxGeometry x="747.27380859375" y="508.5" width="288.4523828125" height="56.00000000000001" as="geometry" /></mxCell><mxCell id="along" value="along = (distance**2 + a**2 - b**2) / (2 *&#10;distance)&#10;height_sq = a**2 - along**2" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize