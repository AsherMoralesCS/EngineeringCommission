 traverse_solver.py lines 224–231"><mxGeometry x="274.23095703125" y="283.0" width="294.5380859375" height="48" as="geometry" /></mxCell><mxCell id="i_error" value="raise TraverseError(&quot;The omitted side has zero&#10;length; its bearing is indeterminate.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_i: traverse_solver.py lines 224–231"><mxGeometry x="35.94858886718751" y="385.0" width="333.102822265625" height="56.00000000000001" as="geometry" /></mxCell><mxCell id="i_candidate" value="result = list(sides)&#10;result[i] = TraverseSide(length,&#10;vector_azimuth(*target))" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_i: traverse_solver.py lines 224–231"><mxGeometry x="398.4345703125" y="381.0" width="198.130859375" height="64" as="geometry" /></mxCell><mxCell id="i_return" value="return [result]" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_i: traverse_solver.py lines 224–231"><mxGeometry x="406.05" y="496.48" width="182.89999999999998" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="iii_start" value="solve_case_iii(sides, target, policy)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="743.5857568359374" y="99.97999999999999" width="253.828486328125" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="iii_system" value="i, j, ae, an, be, bn, determinant =&#10;_length_system(sides)" style="shape=process;html=0;whiteSpace=wrap;rounded=0;fillColor=#edf2fa;strokeColor=#33548b;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="_length_system: traverse_solver.py lines 258–262"><mxGeometry x="766.58447265625" y="183.0" width="207.8310546875" height="50" as="geometry" /></mxCell><mxCell id="iii_singular" value="abs(determinant) &lt;=&#10;policy.singular?" style="shape=rhombus;html=0;whiteSpace=wrap;rounded=0;fillColor=#fff5d9;strokeColor=#806728;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="742.4111328125" y="269.0" width="256.177734375" height="76" as="geometry" /></mxCell><mxCell id="iii_error" value="raise TraverseError(&quot;Singular system: the two&#10;bearings are parallel or opposite; the missing&#10;lengths cannot be uniquely determined.&quot;)" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="632.3456982421875" y="377.15999999999997" width="326.308603515625" height="71.68" as="geometry" /></mxCell><mxCell id="iii_lengths" value="east, north = target&#10;first = (east * bn - be * north) / determinant&#10;second = (ae * north - east * an) /&#10;determinant" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="987.588623046875" y="374.0" width="265.82275390625" height="78" as="geometry" /></mxCell><mxCell id="iii_candidate" value="candidate = list(sides)&#10;candidate[i] = replace(sides[i], length=first)&#10;candidate[j] = replace(sides[j],&#10;length=second)" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#466171;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="986.202880859375" y="481.0" width="268.59423828125" height="78" as="geometry" /></mxCell><mxCell id="iii_return" value="return [candidate]" style="shape=ellipse;html=0;whiteSpace=wrap;rounded=0;fillColor=#e8f0f5;strokeColor=#294759;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="solve_case_iii: traverse_solver.py lines 265–275"><mxGeometry x="1029.05" y="587.98" width="182.89999999999998" height="47.040000000000006" as="geometry" /></mxCell><mxCell id="system_note" value="_length_system(sides):&#10;i, j = [i for i, s in enumerate(sides) if s.length is None]&#10;ae, an = unit_vector(sides[i].azimuth)&#10;be, bn = unit_vector(sides[j].azimuth)&#10;return i, j, ae, an, be, bn, ae * bn - be * an" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="_length_system: traverse_solver.py lines 258–262"><mxGeometry x="36" y="670.0" width="1219.0" height="85" as="geometry" /></mxCell><mxCell id="policy_note" value="NumericalPolicy.length: return self.scale * self.relative&#10;relative: float = 1e-10&#10;singular = 64 * sys.float_info.epsilon&#10;Positive candidate lengths and closure are checked later in solve_traverse()." style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="NumericalPolicy: traverse_solver.py lines 109–127"><mxGeometry x="36" y="765.0" width="1219.0" height="72" as="geometry" /></mxCell><mxCell id="vector_note" value="unit_vector(angle):&#10;return math.sin(math.radians(angle)), math.cos(math.radians(angle))&#10;vector_azimuth(east, north):&#10;angle = math.degrees(math.atan2(east, north)) % 360&#10;return 0.0 if angle == 360 else angle" style="shape=rectangle;html=0;whiteSpace=wrap;rounded=0;fillColor=#f6f7f9;strokeColor=#75828c;fontColor=#203849;fontFamily=DejaVu Sans;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1" tooltip="vector_azimuth: traverse_solver.py lines 183–185"><mxGeometry x="36" y="847.0" width="1219.0" height="85" as="geometry" /></mxCell><mxCell id="e0" value="" parent="1" edge="1" source="i_start" target="i_values" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="421.5" y="168.75" /></Array></mxGeometry></mxCell><mxCell id="e1" value="" parent="1" edge="1" source="i_values" target="i_zero" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="421.5" y="275.86" /></Array></mxGeometry></mxCell><mxCell id="e2" value="" parent="1" edge="1" source="i_zero" target="i_error" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="321.5" y="386.2" /></Array></mxGeometry></mxCell><mxCell id="edge_label2" value="Yes" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="303.13818359375" y="338.58" width="21.7236328125" height="14" as="geometry" /></mxCell><mxCell id="e3" value="" parent="1" edge="1" source="i_zero" target="i_candidate" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="483.75" y="373.69" /></Array></mxGeometry></mxCell><mxCell id="edge_label3" value="No" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="468.130615234375" y="335.49" width="18.23876953125" height="14" as="geometry" /></mxCell><mxCell id="e4" value="" parent="1" edge="1" source="i_candidate" target="i_return" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="497.5" y="489.41999999999996" /></Array></mxGeometry></mxCell><mxCell id="e5" value="" parent="1" edge="1" source="iii_start" target="iii_system" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870.5" y="175.82" /></Array></mxGeometry></mxCell><mxCell id="e6" value="" parent="1" edge="1" source="iii_system" target="iii_singular" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870.5" y="261.71" /></Array></mxGeometry></mxCell><mxCell id="e7" value="" parent="1" edge="1" source="iii_singular" target="iii_error" style="edgeStyle=none;html=0;rounded=0;endArrow=block;endFill=1;strokeColor=#465b68;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850.5" y="371.81" /></Array></mxGeometry></mxCell><mxCell id="edge_label7" value="Yes" style="text;html=0;align=center;fontSize=9;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="832.13818359375" y="343.45" width="21.7236328125" height="14" as="geometry" /></mxCell><mxCell id="e8" value="" parent="1" edge="1" source="iii_singular" target="iii_lengths" s